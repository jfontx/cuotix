NODE_ENV=test
DATABASE_URL=postgresql://cuotix:cuotix@localhost:5432/cuotix_test
JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters

# Límites fijos para que los tests no dependan de la configuración local (.env)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REFRESH_MAX=10
